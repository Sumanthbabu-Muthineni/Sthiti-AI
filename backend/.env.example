# ==============================================================================
# Sthiti-AI (K8s Agentic Watchdog) - Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration (OpenAI or OpenRouter)
# Option 1: OpenAI (e.g. gpt-4o)
OPENAI_API_KEY=your-openai-api-key-here

# Option 2: OpenRouter (Optional, fallback/alternative to OpenAI)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_HTTP_REFERER=https://github.com/Sumanthbabu-Muthineni/Sthiti-AI

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Kubernetes Configuration (Leave empty to auto-detect ~/.kube/config or in-cluster SA)
KUBECONFIG=
MOCK_K8S_FALLBACK=true

# Database Persistence Path (LangGraph SQLite Checkpointer)
DB_PATH=./watchdog_state.db

# GitHub GitOps Configuration (Optional: for opening real PRs for config remediations)
GITHUB_TOKEN=
GITHUB_REPO=your-org-or-username/k8s-manifests
GITOPS_BRANCH_PREFIX=watchdog/auto-fix
